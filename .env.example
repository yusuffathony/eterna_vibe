# ETERNA — example env (copy to .env.local, then `npm run dev`)
# Set NEXT_PUBLIC_STRAPI_URL to the Strapi API host (e.g. https://yoursite.com)
# When unset, the app runs on local demo data so the templates render
# out of the box. Push .env.local to your host; never commit it.
NEXT_PUBLIC_STRAPI_URL=https://yoursite.com
